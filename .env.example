# ============================================================================
# LWX Lab Bot + Silia Creative Intelligence — Exemplo de Configuração (.env)
# NUNCA faça commit de tokens reais neste arquivo.
# ============================================================================

# 1. Discord Bot Core
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=1493045988888285185
DISCORD_GUILD_ID=1441608284061569209
DISCORD_API_BASE=https://www.llewxam.me/discord-api
PORT=10000

# 2. Google Cloud / Vertex AI / Gemini Enterprise Agent Platform (@google/genai)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Em produção no Render (Docker), aponte para o JSON da Service Account montado como Secret File:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcp-service-account.json

# 3. Silia AI Model Router (Principal + Fallbacks Google Cloud)
SILIA_PRIMARY_MODEL=gemini-3.8-flash
SILIA_FALLBACK_MODEL_1=gemini-3.6-flash
SILIA_FALLBACK_MODEL_2=gemini-3.5-flash-lite

# 4. Provedores Secundários de Fallback (Opcionais)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# 5. Google Drive API v3 (OAuth2 para salvar Briefings .docx e Sessões em "Silia AI/")
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Silia AI
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# 6. Google Cloud Firestore (Opcional para sincronização de estado operacional)
FIRESTORE_COLLECTION_PREFIX=silia_sessions
FIRESTORE_ACCESS_TOKEN=
